#!/bin/sh
# gater-managed: installed by Gater; reinstalled on each launch.
# Appends Gater-Dish / Gater-Feature / Gater-Agent trailers to commits made
# inside Gater panes, so who-did-what-for-which-feature survives in git
# (spec §4.3). The current dish comes from .gater/plan.json, so trailers
# follow the plan rather than whatever was true when the pane started.
# Commits made outside Gater (no GATER_PANE_ID) are left untouched.

[ -n "$GATER_PANE_ID" ] || exit 0

# Only fresh commits: leave merges, squashes and amends alone.
case "$2" in
  merge|squash|commit) exit 0 ;;
esac

exec '@GATER_HOOK@' --commit-trailers "$1"
