#!/bin/sh
# Appends Gater accountability trailers to every commit made inside a
# delegate's worktree, so who-did-what-for-which-feature survives outside
# Gater itself (spec §4.3). Reads the current dish/feature/pane from env
# vars Gater sets when it spawns the pane.

commit_msg_file="$1"
commit_source="$2"

# Don't touch merge commits, squash messages, or amends — only fresh commits.
if [ -n "$commit_source" ] && [ "$commit_source" != "message" ] && [ "$commit_source" != "template" ]; then
  exit 0
fi

if [ -z "$GATER_DISH_ID" ]; then
  exit 0
fi

{
  echo ""
  echo "Gater-Dish: $GATER_DISH_ID"
  [ -n "$GATER_FEATURE" ] && echo "Gater-Feature: $GATER_FEATURE"
  [ -n "$GATER_PANE_ID" ] && echo "Gater-Agent: $GATER_PANE_ID"
} >> "$commit_msg_file"
